# Environment
NODE_ENV=development
WEBSITE_URL=http://localhost:4200
# Additional browser origins allowed to use cookie-backed API/auth flows.
# Comma-separated; leave empty unless another trusted frontend needs access.
TRUSTED_ORIGINS=
APPLICATION_ID=
VITE_APPLICATION_ID=
VITE_RUNABLE_AUTH_ISSUER=

# Better Auth - Configuration
BETTER_AUTH_SECRET=
